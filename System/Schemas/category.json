{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdasset.tdengine.com/schemas/category.json",
  "title": "category",
  "description": "schema of an analysis",
  "type": "object",
  "required": [
    "id",
    "name",
    "categoryType"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "number"
    },
    "name": {
      "type": "string",
      "pattern": "^(?!^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(\\..*)?$)[^<>:\"/\\\\|?*\\x00-\\x1F]{1,200}$"
    },
    "description": {
      "type": "string"
    },
    "categoryType": {
      "enum": [
        "Element",
        "Event",
        "Attribute",
        "Analysis",
        "Dashboard",
        "Panel",
        "ExternalTable",
        "InternalTable",
        "ElementTemplate",
        "ActionTemplate",
        "Document"
      ]
    }
  }
}