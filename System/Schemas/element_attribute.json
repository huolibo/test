{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdasset.tdengine.com/schemas/element_attribute.json",
  "title": "element_attribute",
  "description": "schema of a element attribute",
  "type": "object",
  "required": [
    "id"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "number"
    },
    "attrTempId": {
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "value": {
      "type": "string"
    },
    "defaultValue": {
      "type": "string"
    },
    "constantItem": {
      "type": "boolean"
    },
    "hidden": {
      "type": "boolean"
    },
    "excluded": {
      "type": "boolean"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "defaultUom": {
      "type": "number"
    },
    "displayUom": {
      "type": "number"
    },
    "displayDigits": {
      "type": "integer"
    },
    "valueType": {
      "$ref": "./value_type.json"
    },
    "valueLength": {
      "type": "integer"
    },
    "dataReferenceSetting": {
      "$ref": "./data_reference_setting2.json"
    },
    "enabledLimitsTrait": {
      "type": "boolean"
    },
    "traits": {
      "type": "array",
      "items": {
        "$ref": "./attribute_trait.json"
      }
    },
    "childAttributes": {
      "type": "array",
      "items": {
        "$ref": "#"
      }
    },
    "additionalProperties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "value"
        ]
      }
    }
  },
  "$defs": {
    "basicType": {
      "enum": [
        "Bool",
        "TinyInt",
        "SmallInt",
        "Int",
        "BigInt",
        "Float",
        "Double",
        "Guid",
        "Timestamp",
        "Varchar"
      ]
    }
  }
}